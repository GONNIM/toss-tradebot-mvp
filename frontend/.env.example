# Toss Tradebot Frontend — Environment Variables Template
#
# 실 .env.local 파일은 chmod 600. git 추적 X.
# 본 .env.example 은 placeholder만.

# ─── Backend FastAPI 통신 (결정 42) ───
# 로컬 개발 시: http://localhost:8000
# 운영 (optimus8): https://optimus8.cafe24.com (Nginx reverse proxy)
NEXT_PUBLIC_API_BASE_URL=

# Backend ↔ Frontend 내부 인증 (서버 .env 의 INTERNAL_API_KEY 와 동일)
INTERNAL_API_KEY=

# ─── NextAuth.js (결정 38) ───
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ─── Google OAuth (결정 38) ───
# 출처: console.cloud.google.com → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 화이트리스트 (결정 38) ───
# 본인 Gmail 1개만 허용 — 외부인 차단
ALLOWED_EMAIL=suauncle@gmail.com

# ─── Observability (Phase D 주 8 · 2026-07-31) ───
# 미설정 시 조용히 no-op (앱 렌더링 방해 없음).
# 세팅 절차: docs/operations/observability-setup.md
#
# Sentry (frontend/next.js) · @sentry/nextjs · NEXT_PUBLIC_ 접두는 클라이언트 노출 허용.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_APP_ENV=production

# PostHog · posthog.com 무료 티어 → Project API Key (Public) 복사.
# capture_pageview=true · JudgmentDialog 저장 성공 시 capture('judgment_created').
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
