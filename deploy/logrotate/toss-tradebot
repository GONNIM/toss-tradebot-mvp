# 1102-04 · /var/log/toss-tradebot 로그 회전 (deploy.yml [5.6/7] 이 /etc/logrotate.d/ 로 설치)
# systemd StandardError=append: 가 파일을 열어 둔 채 쓰므로 copytruncate (회전 순간 몇 줄 잃을 수 있음).
# 일 1회 logrotate 타이머에서 돌기 때문에 maxsize 는 daily 와 같이 동작한다.
/var/log/toss-tradebot/*.log {
    daily
    rotate 14
    maxsize 100M
    compress
    delaycompress
    copytruncate
    dateext
    missingok
    notifempty
    su root root
}
